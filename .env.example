# ============================================================
# ATLAS & OBSERVATOIRE DES VILLES INTELLIGENTES
# Cloud persistence — copy this file to .env.local for local dev.
# On Vercel, connect the integrations from the Storage tab and
# these variables are created automatically. No code change needed.
# The portal works without any of these (local mode).
# ============================================================

# ------------------------------------------------------------
# 1. FILES — Vercel Blob (required for PDF / PPTX / images)
#    Dashboard → Storage → Create → Blob → Public
#    → Connect to project → tick "Add a read-write token env var".
#    Also used as the corpus index when no KV/Supabase is set.
# ------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------
# 2. DATABASE — choose ONE of the two options below.
#    2a. Vercel KV / Upstash Redis (recommended, zero setup).
#        Dashboard → Storage → Create → Upstash Redis → Connect.
#        Vercel may set either the KV_* or UPSTASH_* names.
# ------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

#    2b. Supabase (alternative). Run supabase/schema.sql first.
#        The public URL + anon key are enough with the provided RLS
#        policies. A service-role key is optional but recommended
#        for server-side writes.
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ATLAS_TABLE=research_projects

# ------------------------------------------------------------
# 3. SECTION PASSCODE — protects submissions and file uploads.
#    Defaults to M1-MEDEA-2026 when unset.
#    Override per section; set to "off" to open the portal.
#    Enforced server-side by api/projects.js and api/upload.js.
#    (Also update LOCAL_CLASS_CODE in portal.js if you change it,
#    so the local/demo mode uses the same code.)
# ------------------------------------------------------------
ATLAS_CLASS_CODE=M1-MEDEA-2026

# ------------------------------------------------------------
# 4. TEACHER CODE — unlocks the teacher space and teacher-only
#    deletion of any project, course, announcement or note.
#    Defaults to PROF-MEDEA-2026 when unset.
#    (Also update LOCAL_TEACHER_CODE in portal.js if you change it.)
# ------------------------------------------------------------
ATLAS_TEACHER_CODE=PROF-MEDEA-2026
